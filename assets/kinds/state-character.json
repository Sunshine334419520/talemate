{
  "id": "state-character",
  "label": "角色现状",
  "section": "现状",
  "order": 80,
  "match": ["state/characters/*.md"],
  "create": "state/characters/{title}.md",
  "fields": [
    { "key": "title", "label": "标题", "type": "string" },
    { "key": "name", "label": "姓名", "type": "string" },
    { "key": "aliases", "label": "别名", "type": "string-list" },
    {
      "key": "status",
      "label": "状态",
      "type": "enum",
      "default": "active",
      "values": [
        { "value": "active", "label": "在场" },
        { "value": "dead", "label": "已故" },
        { "value": "missing", "label": "失联" },
        { "value": "unknown", "label": "未知" }
      ]
    }
  ]
}