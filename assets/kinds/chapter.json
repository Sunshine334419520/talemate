{
  "id": "chapter",
  "label": "章节",
  "description": "One chapter's prose: the actual text the reader will read. Write the scene itself; no notes, outlines, or summaries.",
  "section": "正文",
  "order": 70,
  "match": ["chapters/*.md"],
  "fields": [
    { "key": "title", "label": "标题", "type": "string" },
    {
      "key": "status",
      "label": "状态",
      "type": "enum",
      "default": "draft",
      "values": [
        { "value": "draft", "label": "草稿" },
        { "value": "published", "label": "已发布" }
      ]
    },
    { "key": "beat", "label": "所属节拍", "type": "string" },
    { "key": "order", "label": "排序", "type": "number", "min": 0 }
  ]
}