# ===== talemate P1a 配置 =====
# 复制为 .env 后填写（bun run 会自动加载 .env）

# Provider: "anthropic" | "openai"
#   anthropic = Claude（默认，写作质量最高）
#   openai    = OpenAI 兼容接口（DeepSeek / Moonshot / OpenAI 等，用 TALEMATE_API_BASE 指向）
TALEMATE_PROVIDER=anthropic

# API key（anthropic 时也可直接用系统里的 ANTHROPIC_API_KEY，二选一）
TALEMATE_API_KEY=

# 模型（anthropic 默认 claude-opus-5，质量最高；省钱可改 claude-sonnet-5）
# openai 兼容默认 gpt-4o
TALEMATE_MODEL=claude-opus-5

# openai 兼容时才需要：自定义 base URL，如 https://api.deepseek.com/v1
TALEMATE_API_BASE=

# 单次输出上限（token）。
#   写作场景默认 16000 足够（一章正文 ~3-5k token）。
#   注意：DeepSeek V4 默认开思考，思考会烧掉大半预算导致正文被截断——所以写作时用下面的 TALEMATE_REASONING=off。
#   若开启思考，建议同时把这里调到 32000+。
TALEMATE_MAX_TOKENS=16000

# 推理强度：off | low | high | max（DeepSeek V4 生效）
#   off  = 关闭思考。当前默认：写作靠 prompt 内化纪律，不靠额外推理（省钱、快、不截断）。
#   low/high/max = 开启思考。潜在价值：让模型动笔前先"想清楚该写什么/删什么"（治"屏幕亮着"这类废话）。
#                  开思考时 max_tokens 会自动抬到 32000+，不用手动改。
TALEMATE_REASONING=off

# 采样温度（0-2）。注意：
#   - DeepSeek V4 官方文档：temperature/top_p 无效（静默忽略）——对当前 deepseek 设置不生效。
#   - Anthropic / OpenAI 生效。写作一般 0.7-0.9（低一点更稳、少随机废话；太高会乱）。
#   - 这不是"写作模式"开关，只是稳定度旋钮。
TALEMATE_TEMPERATURE=
